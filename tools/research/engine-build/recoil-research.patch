+++ b/rts/System/Sync/SyncChecker.cpp
@@ -27,6 +27,7 @@ void CSyncChecker::debugSyncCheckThreading()
 	assert(ThreadPool::GetThreadNum() == 0);
 }
 
+#ifndef HM_NO_SYNC_HASH
 void CSyncChecker::Sync(uint32_t val)
 {
 #ifdef DEBUG_SYNC_MT_CHECK
@@ -57,6 +58,8 @@ void CSyncChecker::Sync(const void* p, unsigned size)
 #endif // SYNC_HISTORY
 }
 
+#endif // HM_NO_SYNC_HASH
+
 #ifdef SYNC_HISTORY
 
 unsigned CSyncChecker::nextHistoryIndex = 0;
diff --git a/rts/System/Sync/SyncChecker.h b/rts/System/Sync/SyncChecker.h
