+++ b/rts/System/Sync/SyncChecker.h
@@ -35,8 +35,13 @@ class CSyncChecker {
 		static void SetPrevChecksum(unsigned v) { g_prevChecksum = v; }
 		static void NewFrame();
 		static void debugSyncCheckThreading();
+	#ifdef HM_NO_SYNC_HASH // hail-mary research: no checksum work at all (desyncs go undetected)
