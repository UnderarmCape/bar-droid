# Cross toolchain: the NDK's clang targeting aarch64-linux-gnu (glibc), Debian trixie arm64 sysroot, Recoil's
# official static libs (spring-static-libs 18.04-arm). Research builds only (BAR Droid hail-mary).
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(HM C:/Tools/BARANDROID/hailmary-work)
set(LLVM C:/Tools/BARANDROID/toolchain/android-sdk/ndk/29.0.14206865/toolchains/llvm/prebuilt/windows-x86_64/bin)
set(CMAKE_SYSROOT ${HM}/sysroot)
set(CMAKE_C_COMPILER ${LLVM}/clang.exe)
set(CMAKE_CXX_COMPILER ${LLVM}/clang++.exe)
set(CMAKE_C_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_ASM_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_AR ${LLVM}/llvm-ar.exe CACHE FILEPATH "")
set(CMAKE_RANLIB ${LLVM}/llvm-ranlib.exe CACHE FILEPATH "")
set(CMAKE_NM ${LLVM}/llvm-nm.exe CACHE FILEPATH "")
set(CMAKE_OBJCOPY ${LLVM}/llvm-objcopy.exe CACHE FILEPATH "")
set(CMAKE_STRIP ${LLVM}/llvm-strip.exe CACHE FILEPATH "")
set(CMAKE_LIBRARY_ARCHITECTURE aarch64-linux-gnu)
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld -static-libstdc++ -static-libgcc ${HM}/scripts/finite_shim.o -lm")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld -static-libstdc++ -static-libgcc")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "-fuse-ld=lld -static-libstdc++ -static-libgcc")
set(CMAKE_FIND_ROOT_PATH ${HM}/static-libs ${HM}/sysroot)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_DISABLE_PRECOMPILE_HEADERS ON)


