<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="internalOnly">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 16.1+ keyboard capture (KeyboardShortcuts): the system's shortcuts reach the focused game screen. A normal
         permission, granted at install; older Android does not know it. -->
    <uses-permission android:name="android.permission.CAPTURE_KEYBOARD" tools:ignore="ProtectedPermissions" />
    <!-- Speak to chat (VoiceChat: a three-finger double tap): asked for the first time it is used -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <!-- One UI's Device care, which the loading screen's Free memory button opens (GameActivity): visible to the app -->
    <queries>
        <intent>
            <action android:name="com.samsung.android.sm.ACTION_DASHBOARD" />
        </intent>
        <!-- the phone's speech recognition service (VoiceChat) -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".BarApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.BarDroid"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:supportsRtl="true"
        android:appCategory="game"
        android:isGame="true"
        tools:ignore="UnusedAttribute"
        tools:replace="android:name,android:icon,android:roundIcon,android:label,android:theme">

        <!-- A game for Android and One UI (Kailil, 2026-11-06: "get our game to run in game mode on the phone so game
             boost is on"): Game Booster's panel and settings, Gaming Hub, Android's game modes. The app sets its own
             resolution and frame pacing, so Android's downscaling and frame rate override stay off. -->
        <meta-data android:name="android.game_mode_config" android:resource="@xml/game_mode_config" />

        <!-- The app icon: straight into the lobby, BAR's icon on black meanwhile. -->
        <activity
            android:name=".StartActivity"
            android:exported="true"
            android:theme="@style/Theme.BarDroid.Start"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode|smallestScreenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- Install, settings, logs: long-press the app icon → Launcher (res/xml/shortcuts.xml). A task of its own: in the
             icon's task, the icon brought it back instead of opening the lobby once it had been shown (Kailil's Fold7,
             2026-11-10). -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:taskAffinity=".Launcher"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode|smallestScreenSize|screenLayout" />

        <!-- The X display + input surface, inherited from Termux:X11's MainActivity. -->
        <activity
            android:name=".GameActivity"
            android:exported="false"
            android:taskAffinity=".GameActivity"
            android:theme="@style/LorieAppTheme"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:configChanges="fontScale|orientation|screenSize|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|screenLayout|touchscreen|uiMode|smallestScreenSize|density"
            android:resizeableActivity="true"
            android:windowSoftInputMode="stateHidden|adjustNothing" />

        <!-- Keep Termux:X11's own activity (internal intents reference it) but take it out of the launcher.
             Termux:X11 exports these for the Termux app (another UID); our X server runs under our own UID,
             so nothing needs to reach them from outside. -->
        <activity android:name="com.termux.x11.MainActivity" tools:node="merge" android:label="@string/app_name"
            android:exported="false" tools:replace="android:label,android:exported">
            <intent-filter tools:node="removeAll" />
        </activity>
        <activity android:name="com.termux.x11.LoriePreferences" tools:node="merge" android:label="@string/display_prefs_title"
            android:exported="false" tools:replace="android:label,android:exported">
            <intent-filter tools:node="removeAll" />
        </activity>
        <receiver android:name="com.termux.x11.LorieApp$Receiver" android:exported="false" tools:replace="android:exported" />
        <!-- Termux:X11's key interception service, optional (README "Keyboard shortcuts"): named for this app.
             Its config (res/xml/accessibility_service_config.xml) replaces the library's, whose settings screen
             does not exist in this app. -->
        <service android:name="com.termux.x11.utils.KeyInterceptor" tools:node="merge"
            android:label="@string/key_capture_service" tools:replace="android:label" />
        <receiver android:name="com.termux.x11.LoriePreferences$Receiver" android:exported="false" tools:replace="android:exported" />

        <!-- Share logs button (LogShare): zips in cache/share, handed out read-only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/bardroid_share_paths" />
        </provider>

        <service
            android:name=".GameService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs the Linux game container (installer, X server and the Recoil engine) while the game is open" />
        </service>
    </application>
</manifest>
