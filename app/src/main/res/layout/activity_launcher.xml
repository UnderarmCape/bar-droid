<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:clipToPadding="false"
    android:padding="12dp">

    <!-- Above the settings, or beside them on a wide screen: LauncherActivity.fitLayout. -->
    <ScrollView
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <Button style="@style/LauncherButton" android:id="@+id/btnInstall" android:text="@string/btn_install" />
                <Button style="@style/LauncherButton.Main" android:id="@+id/btnPlay" android:text="@string/btn_play" />
                <Button style="@style/LauncherButton.Main" android:id="@+id/btnLobby" android:text="@string/btn_lobby" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <Button style="@style/LauncherButton.Small" android:id="@+id/btnGlCheck" android:text="@string/btn_glcheck" />
                <Button style="@style/LauncherButton.Small" android:id="@+id/btnBench" android:text="@string/btn_bench" />
                <Button style="@style/LauncherButton.Small" android:id="@+id/btnDisplayPrefs" android:text="@string/btn_display_prefs" />
                <Button style="@style/LauncherButton.Small" android:id="@+id/btnShareLogs" android:text="@string/btn_share_logs" />
                <Button style="@style/LauncherButton.Small" android:id="@+id/btnStop" android:text="@string/btn_stop" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Where the settings scroll under the buttons (its size: LauncherActivity.fitLayout); they fade out at its edges
         (a line cut in half under the divider read as a glitch, dev phone 2026-11-03). -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0.4"
        android:background="?attr/colorAccent" />

    <!-- (its scrollbar in a margin of its own, out in the screen's edge: over the text it covered the long settings'
         line ends; LauncherActivity.fitLayout) -->
    <ScrollView
        android:id="@+id/settings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingEnd="10dp"
        android:scrollbarStyle="outsideOverlay"
        android:requiresFadingEdge="vertical"
        android:fadingEdgeLength="24dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- (on a wide screen under the buttons instead: LauncherActivity.fitLayout); the launcher's own type, a
                 step quieter than the settings (in monospace its sentences broke like a log's lines); 12sp: a phone
                 turned sideways has room for all of it under the buttons -->
            <TextView
                android:id="@+id/device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondary"
                android:paddingTop="8dp" />

            <TextView style="@style/LauncherSection" android:text="@string/settings_game" />

            <TextView style="@style/LauncherFieldLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/lbl_map" />
            <!-- (14sp: the settings' size; the field's own 18sp stood out over every setting) -->
            <EditText android:id="@+id/edMap" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:textSize="14sp" android:importantForAutofill="no" />

            <CheckBox style="@style/LauncherCheck" android:id="@+id/cbAudio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cb_audio" />
            <CheckBox style="@style/LauncherCheck" android:id="@+id/cbAutoLobby" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cb_auto_lobby" />
            <CheckBox style="@style/LauncherCheck" android:id="@+id/cbAutoUpdate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cb_auto_update" />
            <CheckBox style="@style/LauncherCheck" android:id="@+id/cbGamepadGame" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cb_gamepad_game" />
            <CheckBox style="@style/LauncherCheck" android:id="@+id/cbRtsTouch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cb_rts_touch" />
            <CheckBox style="@style/LauncherCheck" android:id="@+id/cbCaptureShortcuts" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cb_capture_shortcuts" />

            <TextView style="@style/LauncherSection" android:text="@string/settings_graphics" />

            <TextView style="@style/LauncherFieldLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/lbl_fps_cap" />
            <RadioGroup android:id="@+id/rgFpsCap" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <RadioButton android:id="@+id/rbFps30" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rb_fps30" />
                <RadioButton android:id="@+id/rbFps60" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rb_fps60" />
                <RadioButton android:id="@+id/rbFpsNone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rb_fps_none" />
            </RadioGroup>
            <TextView style="@style/LauncherFieldLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/lbl_render_scale" android:paddingTop="8dp" />
            <RadioGroup android:id="@+id/rgRenderScale" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <RadioButton android:id="@+id/rbRender100" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rb_render100" />
                <RadioButton android:id="@+id/rbRender85" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rb_render85" />
                <RadioButton android:id="@+id/rbRender70" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rb_render70" />
                <RadioButton android:id="@+id/rbRenderNative" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rb_render_native" />
            </RadioGroup>
            <CheckBox style="@style/LauncherCheck" android:id="@+id/cbUpscale" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cb_upscale" />
            <CheckBox style="@style/LauncherCheck" android:id="@+id/cbUpscaleCompare" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cb_upscale_compare" />

            <TextView style="@style/LauncherSection" android:text="@string/settings_advanced" />

            <!-- (the name and what it does above the field, as the map's and Mesa's) -->
            <TextView style="@style/LauncherFieldLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/lbl_workers" />
            <EditText android:id="@+id/edWorkers" android:layout_width="64dp" android:layout_height="wrap_content" android:inputType="number" android:textSize="14sp" android:importantForAutofill="no" />

            <TextView style="@style/LauncherFieldLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/lbl_mesa_url" />
            <!-- (wrapped, the whole address shown: a single line ran off the screen mid-word) -->
            <EditText android:id="@+id/edMesaUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri|textMultiLine" android:maxLines="4" android:imeOptions="actionDone" android:textSize="11sp" android:importantForAutofill="no" />

            <CheckBox style="@style/LauncherCheck" android:id="@+id/cbZink" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cb_zink" />
            <CheckBox style="@style/LauncherCheck" android:id="@+id/cbCompat45" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cb_compat45" />
            <CheckBox style="@style/LauncherCheck" android:id="@+id/cbLobbyBridge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cb_lobby_bridge" />
            <CheckBox style="@style/LauncherCheck" android:id="@+id/cbNoSeccomp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cb_noseccomp" />
            <CheckBox style="@style/LauncherCheck" android:id="@+id/cbVerboseX" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/cb_verbosex" />
            <Button android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAllCaps="false" android:text="@string/btn_save" />

            <!-- (the log: under the buttons on a wide screen, LauncherActivity.fitLayout) -->
            <TextView style="@style/LauncherSection" android:id="@+id/logTitle" android:text="@string/log_title" />
            <ScrollView android:id="@+id/logScroll" android:layout_width="match_parent" android:layout_height="300dp" android:nestedScrollingEnabled="true" android:background="#11000000">
                <!-- (padding: the lines ran along the box's left edge) -->
                <TextView android:id="@+id/log" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:textSize="10sp" android:textIsSelectable="true" android:padding="6dp" />
            </ScrollView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
