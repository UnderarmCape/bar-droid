<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BarDroid" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <!-- The launcher's rows of buttons: one height in a row, words kept whole, a row's words in one size
         (LauncherActivity.fitRow). The padding counts from the view's edge: the button's own shape sits 4 dp inside
         it, so 6 dp left the words 2 dp from the edge one sees ("Install / Update", "Benchmark"). -->
    <style name="LauncherButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">9dp</item>
        <item name="android:paddingRight">9dp</item>
        <item name="android:hyphenationFrequency">none</item>
        <item name="android:maxLines">1</item>
        <item name="android:autoSizeTextType">none</item>
        <item name="android:textSize">14sp</item>
        <item name="android:foreground">@drawable/launcher_focus</item>
    </style>
    <!-- What the launcher is for: playing. In the settings' accent colour. -->
    <style name="LauncherButton.Main">
        <item name="android:backgroundTint">?attr/colorAccent</item>
        <item name="android:textColor">@color/ic_bg</item>
    </style>
    <!-- Five to a row: smaller words (sized one by one, the longest either shrank alone or, with little padding, ran
         from edge to edge of its button). -->
    <style name="LauncherButton.Small">
        <item name="android:textSize">11sp</item>
    </style>

    <!-- A setting: air between the long ones, the box at the first line, the box on the column's edge (the checkbox's
         own inset put it 7 dp in from the words, the map field's line and the section names above it; dev phone
         screenshot 2026-11-16, as the buttons' -4dp). -->
    <style name="LauncherCheck">
        <item name="android:layout_marginStart">-7dp</item>
        <item name="android:gravity">top</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <!-- One choice of a row: air after its words, so they read as its own and not the next circle's (they stood ~8 dp
         from it, as near as to their own circle). 8 dp more: at 12 the last of Game resolution's four, "Native", broke
         over two lines on a 360 dp wide screen. -->
    <style name="LauncherRadio">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>
    <!-- A row of choices: its first circle on the column's edge, as the settings' boxes (the radio button's own inset put
         it 6 dp in; dev phone screenshot 2026-11-16). -->
    <style name="LauncherRadioRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">-6dp</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <!-- A text field's name, as a setting's reads (white; an explanation after a line break, smaller and grey:
         LauncherActivity.explainSettings, the tag "explain"). -->
    <style name="LauncherFieldLabel">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:tag">explain</item>
    </style>

    <!-- A heading in the settings list. -->
    <style name="LauncherSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorAccent</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!-- StartActivity: nothing but BAR's icon on black until the lobby is up. -->
    <style name="Theme.BarDroid.Start" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/start_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
