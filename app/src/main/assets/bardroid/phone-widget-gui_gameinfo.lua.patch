BAR Droid phone version of BAR's Game info (luaui/widgets/gui_gameinfo.lua): the window no wider than the screen
(docs/upstream/bar-windows-upright.patch, written for BAR: its scale is the screen's height over 1080, so upright it was
about twice the width of the screen, its right side cut off), and as large as fits below BAR's top bar (sideways BAR's
size left it about half the screen on a phone, its words some 1.5 mm; the app's dock steps aside while it is open:
bardroid_portrait.lua SP.WINDOWS), nearly opaque (the chat's lines read through its header: the GUI shader's blur is
off on phones), and a close button at its header's right end (a phone has no Escape at hand, and no room around the
window to tap), red with a white cross as the app's Settings and Statistics have. Applied by the engine
(BarDroidPhoneLuaDir) to BAR's file as LuaUI loads it; if a block finds no place, BAR's own file runs.

@@@ find
local widgetScale = (vsy / 1080)
@@@ with
local widgetScale = math.min(vsy / 1080, vsx / (screenWidthOrg + 50)) -- BAR Droid (phone; docs/upstream/bar-windows-upright.patch): no wider than the screen
@@@ end

@@@ find
	widgetScale = (vsy / 1080)

	screenHeight = mathFloor(screenHeightOrg * widgetScale)
	screenWidth = mathFloor(screenWidthOrg * widgetScale)
	screenX = mathFloor((vsx * 0.5) - (screenWidth / 2))
	screenY = mathFloor((vsy * 0.5) + (screenHeight / 2))
@@@ with
	-- BAR Droid (phone): as large as fits below BAR's top bar and no wider than the screen, the dock aside meanwhile
	do
		local droidM = math.max(4, mathFloor(math.min(vsx, vsy) * 0.012))
		local droidTop = vsy - mathFloor(96 * (vsy / 1080)) -- (BAR's top bar)
		widgetScale = math.min((vsx - 2 * droidM) / screenWidthOrg, (droidTop - 2 * droidM) / screenHeightOrg)
		screenHeight = mathFloor(screenHeightOrg * widgetScale)
		screenWidth = mathFloor(screenWidthOrg * widgetScale)
		screenX = mathFloor((vsx * 0.5) - (screenWidth / 2))
		screenY = mathFloor(droidTop / 2 + screenHeight / 2)
	end
@@@ end

@@@ find
		WG.FlowUI.clampedOpacity
@@@ with
		math.max(0.94, WG.FlowUI.clampedOpacity or 0) -- BAR Droid (phone): nearly opaque, the GUI shader's blur is off
@@@ end

@@@ find
	local togX2 = area.x2 - metrics.edgeInset
@@@ with
	-- BAR Droid (phone): the close button at the header's right end (metrics.droidClose), the toggle and the search left of it
	local droidCloseW = mathFloor(metrics.headerH * 1.5)
	metrics.droidClose = { area.x2 - metrics.edgeInset - droidCloseW, rowBottom, area.x2 - metrics.edgeInset, rowTop }
	local togX2 = area.x2 - metrics.edgeInset - droidCloseW - mathFloor(12 * s)
@@@ end

@@@ find
	queueText(L.titleText, area.x1 + metrics.sidePad, area.y2 - metrics.titleY, metrics.titleFs, "ov", 1)
@@@ with
	queueText(L.titleText, area.x1 + metrics.sidePad, area.y2 - metrics.titleY, metrics.titleFs, "ov", 1)
	-- BAR Droid (phone): the close button, red with a white cross
	if metrics.droidClose then
		local c = metrics.droidClose
		RectRound(c[1], c[2], c[3], c[4], math.max(2, mathFloor((c[4] - c[2]) * 0.12)), 1, 1, 1, 1,
			{ 0.42, 0.08, 0.06, 0.9 }, { 0.62, 0.16, 0.12, 0.95 })
		local cx, cy, a = (c[1] + c[3]) / 2, (c[2] + c[4]) / 2, (c[4] - c[2]) * 0.2
		local t = math.max(1.5, a * 0.17)
		gl.Texture(false)
		glColor(0.95, 0.95, 0.95, 1)
		gl.BeginEnd(GL.QUADS, function()
			for _, d in ipairs({ { a, a }, { a, -a } }) do
				local len = math.sqrt(d[1] * d[1] + d[2] * d[2])
				local nx, ny = -d[2] / len * t, d[1] / len * t
				gl.Vertex(cx - d[1] + nx, cy - d[2] + ny)
				gl.Vertex(cx + d[1] + nx, cy + d[2] + ny)
				gl.Vertex(cx + d[1] - nx, cy + d[2] - ny)
				gl.Vertex(cx - d[1] - nx, cy - d[2] - ny)
			end
		end)
		glColor(1, 1, 1, 1)
	end
@@@ end

@@@ find
	-- A press on a top bar button is the top bar's to handle: it closes the open windows
@@@ with
	-- BAR Droid (phone): the close button (metrics.droidClose), closed as BAR's own ways close it
	if metrics.droidClose then
		local c = metrics.droidClose
		if x >= c[1] and x <= c[3] and y >= c[2] and y <= c[4] then
			if release then
				showOnceMore = true
				closePanel()
			end
			return true
		end
	end
	-- A press on a top bar button is the top bar's to handle: it closes the open windows
@@@ end
