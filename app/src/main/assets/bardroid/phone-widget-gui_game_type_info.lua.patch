BAR Droid phone version of BAR's Game Type Info (luaui/widgets/gui_game_type_info.lua): the "Victory condition: ..."
line at least 7.5 % of the screen's height above its anchor (docs/upstream/bar-pregame-upright.patch, written for BAR:
upright its fixed offset left it inside the start position suggestions' tutorial, the two texts over each other).
And lifted above the app's touch dock where the dock would cover it (sideways it lay behind the dock's left block,
"Victory c" showing beside it; dev phone 2026-11-19), and above the camera's turn rail along the dock's top
(bardroid_camctl.lua, WG.BarDroidCamCtl.rects: a replay upright drew the rail's line through the words, the spectator's
dock being lower; dev phone 2026-11-19). Applied by the engine (BarDroidPhoneLuaDir) to BAR's file as LuaUI loads it; if a block finds no place, BAR's own file
runs.

@@@ find
		messages[1].x = widgetScale * 60
@@@ with
		messages[1].x = math.max(widgetScale * 60, vsy * 0.075) -- BAR Droid (phone; docs/upstream/bar-pregame-upright.patch): clear of the start position tutorial upright
@@@ end

@@@ find
		messages[3].x = 40 * widgetScale
@@@ with
		messages[3].x = math.max(40 * widgetScale, vsy * 0.075 - 20 * widgetScale) -- BAR Droid (phone): under the first, as before
@@@ end

@@@ find
	glPushMatrix()
	glTranslate((vsx * 0.5), (vsy * y), 0) --has to be below where newbie info appears!
@@@ with
	glPushMatrix()
	-- BAR Droid (phone): above the app's touch dock where the dock would cover the lines (their lowest one's foot under
	-- its top, the dock across the screen's middle); not past 85 % of the screen's height
	local droidY = vsy * y
	local droidP = WG.BarDroidPortrait
	local droidDock = droidP and droidP.dock and not (droidP.aside and droidP.aside()) and droidP.dock()
	if droidDock then
		local low, size
		for _, message in pairs(messages) do
			if message.str and message.x and (not low or message.x < low) then
				low, size = message.x, message.y or 0
			end
		end
		if low then
			local foot = droidY + 1.5 * (low - size * 0.35)
			local floorY = droidDock[4] -- (or the camera's turn rail on it, GL pixels { x0, y0, x1, y1 })
			local droidCam = WG.BarDroidCamCtl
			local ok, _, _, turn = pcall(function() return droidCam.rects() end)
			if ok and type(turn) == "table" and tonumber(turn[4]) and turn[2] <= droidDock[4] + vsy * 0.05 then
				floorY = math.max(floorY, turn[4])
			end
			if foot < floorY and droidDock[1] < vsx * 0.7 and droidDock[3] > vsx * 0.3 then
				droidY = math.min(droidY + floorY - foot + math.floor(vsy * 0.015), vsy * 0.85)
			end
		end
	end
	glTranslate((vsx * 0.5), droidY, 0) --has to be below where newbie info appears!
@@@ end
