@@@ find
	for i = 1, #unitIsReadyTab do
		if UnitDefNames[UnitDefs[unitIsReadyTab[1][1]].name .. "_scav"].id then
			unitIsReadyScavAppend[#unitIsReadyScavAppend + 1] =
				{ UnitDefNames[UnitDefs[unitIsReadyTab[i][1]].name .. "_scav"].id, unitIsReadyTab[i][2] }
		end
	end
@@@ with
	for i = 1, #unitIsReadyTab do
		-- BAR Droid (phone): each entry's own unit ([i], it read [1] for every one), and only units this game has
		local ud = unitIsReadyTab[i][1] and UnitDefs[unitIsReadyTab[i][1]]
		local scav = ud and UnitDefNames[ud.name .. "_scav"]
		if scav then
			unitIsReadyScavAppend[#unitIsReadyScavAppend + 1] = { scav.id, unitIsReadyTab[i][2] }
		end
	end
@@@ end
