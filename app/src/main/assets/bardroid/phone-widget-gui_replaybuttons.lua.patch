BAR Droid phone version of BAR's Replay buttons (luaui/widgets/gui_replaybuttons.lua): the speed column above the app's
dock. BAR puts the column (skip or pause, then 0.5x to 20x) at the screen's left edge from 14.5 % of its height up; the
app's dock, upright a third to a half of the height, lay over all but the fastest speeds, 1x among them (dev phone,
2026-11-15, a replay spectated upright at the unfolded Fold7's 1080x1198: 4x the lowest in sight). Where the dock lies
under the column it starts just above the dock's top; back at BAR's place when the dock goes (sideways pinned to the
right, folded away by HIDE, no dock). The file is the same in every BAR release on the dev phone (test-31465 to
test-31958), so this fits replays of all of them. Applied by the engine (BarDroidPhoneLuaDir) to BAR's file as LuaUI
loads it; if a block finds no place, BAR's own file runs. Upright the column is also as wide and its words as large as on
the same screen sideways (2026-11-17: BAR sizes them by fractions of the width, some 35 pixels wide upright, words of 11),
and its buttons no taller than the room under BAR's minimap (sideways the fastest three lay under it). And its rect for
the app's touch widget (WG.BarDroidTapPanels): after a tap on a speed the pointer hides as over BAR's interface, while a
finger's drag from the column still pans (2026-11-19: an IsAbove did the first, but made such drags mouse drags along
a tall strip of the screen's left edge upright). And the speed the replay runs at lit, gold: BAR lights only the button
under the mouse (its active_button is never set), so on a phone nothing showed which speed was on (dev phone,
2026-11-19, a replay at 10x upright: the column all alike).

@@@ find
	if buttonsList then
		gl.CallList(buttonsList)
	end
@@@ with
	if buttonsList then
		gl.CallList(buttonsList)
	end
	-- BAR Droid (phone): the speed the replay runs at lit, gold (BAR lights the button under the mouse only)
	local droidSpeed = Spring.GetGameSpeed()
	for i = 1, #speeds do
		local b = buttons[i]
		if b and math.abs(speeds[i] - (droidSpeed or 0)) < 0.01 then
			glBlending(GL_SRC_ALPHA, GL_ONE)
			RectRound(
				mathFloor((b.x * vsx) + 0.5),
				mathFloor((b.y * vsy) + 0.5),
				mathFloor(((b.x + bWidth) * vsx) + 0.5),
				mathFloor(((b.y + bHeight) * vsy) + 0.5),
				bgpadding * 0.5,
				0,
				1,
				1,
				0,
				{ 0.45, 0.32, 0.05, 0.45 },
				{ 1, 0.8, 0.35, 0.35 }
			)
			glBlending(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA)
			break
		end
	end
@@@ end

@@@ find
function widget:Update(dt)
	prevIsActive = isActive
	isActive = #Spring.GetSelectedUnits() == 0
end
@@@ with
function widget:Update(dt)
	prevIsActive = isActive
	isActive = #Spring.GetSelectedUnits() == 0
	-- BAR Droid (phone): the column above the app's dock where the dock lies under it
	local droidP = WG.BarDroidPortrait
	local dock = droidP and droidP.active and droidP.active() and droidP.dock and droidP.dock() or nil
	local base = 0.145
	if dock and dock[1] <= bWidth * vsx then
		base = math.max(base, (dock[4] + 8) / vsy)
	end
	-- and its buttons no taller than the room under BAR's minimap allows: with a phone's interface scale the eleven ran
	-- up under the minimap sideways, 20x, 15x and 10x out of sight (dev phone, a replay, 2026-11-17)
	local h = buttonHeight * ui_scale
	local mx, my, msx, msy, minimized = Spring.GetMiniMapGeometry()
	if mx and msx and msx > 0 and msy and msy > 0 and not minimized and mx < bWidth * vsx then
		local bottom = Spring.IsAboveMiniMap(mx + msx / 2, my + msy / 2) and my or vsy - my - msy -- (its y from the top)
		local room = bottom / vsy - base - 0.004
		if room > 0 then
			h = math.min(h, room / (#speeds + 1))
		end
	end
	if #buttons > 0 and (buttons[#buttons].y ~= base or h ~= bHeight) then
		bHeight = h
		local dy = 0
		for i = 1, #speeds do
			dy = dy + bHeight
			buttons[i].y = base + dy
		end
		buttons[#buttons].y = base
		wPos.y = base
		sceduleUpdate = true
	end
	-- BAR Droid (phone): the column for the app's touch widget (bardroid_touch.lua's WG.BarDroidTapPanels): a tap on a
	-- speed hides the pointer as on the interface, a finger's drag from the column still pans
	local droidTap = WG.BarDroidTapPanels
	if droidTap and not droidTap.replaybuttons then
		droidTap.replaybuttons = function()
			if not isActive or #buttons < 2 then
				return nil
			end
			local foot, top = buttons[#buttons], buttons[#buttons - 1]
			return foot.x * vsx, foot.y * vsy, (top.x + bWidth) * vsx, (top.y + bHeight) * vsy
		end
	end
end
@@@ end

@@@ find
function widget:Shutdown()
@@@ with
function widget:Shutdown()
	if WG.BarDroidTapPanels then -- BAR Droid (phone): the column no longer the touch widget's
		WG.BarDroidTapPanels.replaybuttons = nil
	end
@@@ end

@@@ find
	bHeight = buttonHeight * ui_scale
	bWidth = buttonWidth * ui_scale
@@@ with
	bHeight = buttonHeight * ui_scale
	bWidth = buttonWidth * ui_scale
	-- BAR Droid (phone): upright the column as wide as on the same screen sideways (a fraction of the width made the
	-- buttons some 35 pixels wide on a phone upright, their words 11 pixels)
	if vsy > vsx then
		bWidth = bWidth * vsy / vsx
	end
@@@ end

