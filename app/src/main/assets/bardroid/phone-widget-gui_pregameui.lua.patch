@@@ with
function widget:Shutdown()
	if WG.BarDroidTapPanels then -- BAR Droid (phone): the button no longer the touch widget's
		WG.BarDroidTapPanels.pregameui = nil
	end
	gl.DeleteList(buttonList)
@@@ end

