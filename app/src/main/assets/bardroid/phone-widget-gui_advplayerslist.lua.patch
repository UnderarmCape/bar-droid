BAR Droid phone version of BAR's AdvPlayersList (luaui/widgets/gui_advplayerslist.lua): the player list drawn again half as
often (every 1.6 s instead of 0.8) and its resource bars a quarter as often (0.6 s instead of 0.15; BAR stretches both
with the number of players). Each redraw renders the whole list into its textures: in a late 16-player game the list cost
0.4-0.5 % of the dev phone's main thread (docs/ENGINE-SIM.md on engine/sim, "BAR's Lua on phones"). And a way to hide the
list (WG.advplayerlist_api.SetHidden: no drawing, no presses, its position collapsed onto its foot so the panels BAR
stacks on it stay in place): the app's dock folded while spectating hides it (Kailil, 2026-11-11: "Hide the team list").
And a press taken by the list under it, not by where the pointer was at the last check (a finger's tap after one on the
list went to the list).
Applied by the engine (BarDroidPhoneLuaDir) to BAR's file as LuaUI loads it; if a block finds no place, BAR's own file
runs.

@@@ find
local updateRate = 0.8
@@@ with
local updateRate = 1.6 -- BAR Droid (phone): 0.8
@@@ end

@@@ find
local updateFastRate = 0.15 -- only updates resources
@@@ with
local updateFastRate = 0.6 -- only updates resources -- BAR Droid (phone): 0.15
@@@ end

@@@ find
	WG.advplayerlist_api.GetPosition = function()
		return apiAbsPosition
	end
@@@ with
	WG.advplayerlist_api.GetPosition = function()
		-- BAR Droid (phone): hidden, a rect collapsed onto the list's foot (the panels BAR stacks on it stay there); a
		-- new table only when the list's own changes (as BAR's: the panels ask every frame)
		local api = WG.advplayerlist_api
		if api._bardroidHidden then
			if api._bardroidFrom ~= apiAbsPosition then
				local p = apiAbsPosition
				api._bardroidFrom, api._bardroidCollapsed = p, { p[3], p[2], p[3], p[4], p[5], p[6], p[7] }
			end
			return api._bardroidCollapsed
		end
		return apiAbsPosition
	end
	-- BAR Droid (phone): the list hidden or shown again (the app's dock folded while spectating)
	WG.advplayerlist_api.SetHidden = function(hidden)
		WG.advplayerlist_api._bardroidHidden = hidden and true or nil
		WG.advplayerlist_api._bardroidFrom = nil
	end
	WG.advplayerlist_api.GetHidden = function()
		return WG.advplayerlist_api._bardroidHidden == true
	end
@@@ end

@@@ find
function widget:DrawScreen()
	local drawGameFrame = spGetGameFrame()
@@@ with
function widget:DrawScreen()
	if WG.advplayerlist_api and WG.advplayerlist_api._bardroidHidden then -- BAR Droid (phone): hidden
		return
	end
	local drawGameFrame = spGetGameFrame()
@@@ end

@@@ find
function widget:MousePress(x, y, button)
	--super ugly code here
@@@ with
function widget:MousePress(x, y, button)
	if WG.advplayerlist_api and WG.advplayerlist_api._bardroidHidden then -- BAR Droid (phone): hidden
		return false
	end
	--super ugly code here
@@@ end

@@@ find
	--handles takes & related messages
	local mx, my = spGetMouseState()
@@@ with
	--handles takes & related messages
	local mx, my = spGetMouseState()
	-- BAR Droid (phone): hidden, no hover either: its tooltip text was kept from before and showed over the map wherever
	-- the list had been (review 2026-11-16)
	if WG.advplayerlist_api and WG.advplayerlist_api._bardroidHidden then
		mx, my = -1, -1
	end
@@@ end

@@@ find
	prevClickTime = clickTime
	if hoverPlayerlist then
		return true
	end
end
@@@ with
	prevClickTime = clickTime
	-- BAR Droid (phone): the list under the press itself, not under the pointer at its last check (Update's rect): a
	-- finger moves the pointer and presses in one frame, so right after a tap on the list the next tap elsewhere was
	-- taken here, as the top bar's (docs/upstream/bar-topbar-press-hover.patch); hidden, the press returned above
	if math_isInRect(x, y, apiAbsPosition[2] - 1, apiAbsPosition[3] - 1, apiAbsPosition[4] + 1, apiAbsPosition[1] + 1) then
		return true
	end
end
@@@ end
