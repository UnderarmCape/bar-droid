# Line endings as each file's consumer needs them, whatever the checkout's core.autocrlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.sh    text eol=lf
gradlew text eol=lf
*.lua   text eol=lf
*.java  text eol=lf
*.patch -text
# the menu copies' patches the phone applies to BAR's files (BuildMenuPatches): a CRLF checkout found no place in them
*.patches text eol=lf
