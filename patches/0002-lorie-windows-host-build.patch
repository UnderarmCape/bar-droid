 add_library(xkbcomp STATIC
@@ -69,3 +87,12 @@ target_compile_options(xkbcomp PRIVATE ${common_compile_options} "-fvisibility=h
 target_apply_patch(xkbcomp "${CMAKE_CURRENT_SOURCE_DIR}/xkbcomp" "${CMAKE_CURRENT_SOURCE_DIR}/patches/xkbcomp.patch")
 target_apply_patch(xkbfile "${CMAKE_CURRENT_SOURCE_DIR}/libxkbfile" "${CMAKE_CURRENT_SOURCE_DIR}/patches/xkbfile.patch")
 target_apply_patch(X11 "${CMAKE_CURRENT_SOURCE_DIR}/libx11" "${CMAKE_CURRENT_SOURCE_DIR}/patches/x11.patch")
+if(CMAKE_HOST_WIN32)
+    # Windows file names are case-insensitive: with libx11/include/X11 on the include path, the NDK's
+    # <xlocale.h> (included by <time.h>) resolves to X11's Xlocale.h. Use a copy of that directory without it.
+    set(x11_nocase_dir "${CMAKE_CURRENT_BINARY_DIR}/libx11-include-X11")
+    file(COPY "${CMAKE_CURRENT_SOURCE_DIR}/libx11/include/X11/" DESTINATION "${x11_nocase_dir}" PATTERN "Xlocale.h" EXCLUDE)
+    get_target_property(xkbcomp_includes xkbcomp INCLUDE_DIRECTORIES)
+    list(TRANSFORM xkbcomp_includes REPLACE "^.*libx11/include/X11$" "${x11_nocase_dir}")
+    set_target_properties(xkbcomp PROPERTIES INCLUDE_DIRECTORIES "${xkbcomp_includes}")
+endif()
