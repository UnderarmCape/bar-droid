+        COMMAND "${LORIE_HOST_CC}" "-o" "${CMAKE_CURRENT_BINARY_DIR}/makekeys.exe" "${CMAKE_CURRENT_SOURCE_DIR}/libx11/src/util/makekeys.c"
+        COMMAND "${CMAKE_COMMAND}" "-DMAKEKEYS=${CMAKE_CURRENT_BINARY_DIR}/makekeys.exe" "-DOUT=${CMAKE_CURRENT_BINARY_DIR}/ks_tables.h"
+            -P "${CMAKE_CURRENT_LIST_DIR}/run-makekeys.cmake"
+        WORKING_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/xorgproto/include/X11"
+        COMMENT "Generating source code (ks_tables.h)"
+        VERBATIM)
+endif()
 
