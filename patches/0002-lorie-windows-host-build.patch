diff --git a/lorie/src/main/cpp/recipes/fix-patch-headers.py b/lorie/src/main/cpp/recipes/fix-patch-headers.py
new file mode 100644
index 0000000..f93acd3
--- /dev/null
+++ b/lorie/src/main/cpp/recipes/fix-patch-headers.py
@@ -0,0 +1,36 @@
+# Copies a patch into the strict form `git apply` wants (used on Windows hosts, which have no GNU patch):
+#  - adds the "--- <path>" line that some of these patches omit before "+++ <path>";
+#  - restores the leading space of blank context lines that lost it (GNU patch tolerates both).
+import re
+import sys
+
+HUNK = re.compile(rb"^@@ -\d+(?:,(\d+))? \+\d+(?:,(\d+))? @@")
+
+src, dst = sys.argv[1], sys.argv[2]
+with open(src, "rb") as f:
+    lines = f.read().split(b"\n")
+out = []
+old = new = 0
+for line in lines:
+    if old > 0 or new > 0:  # inside a hunk: count lines against the header
+        if line == b"":
+            line = b" "
+        tag = line[:1]
+        if tag == b" ":
+            old -= 1
+            new -= 1
+        elif tag == b"-":
+            old -= 1
+        elif tag == b"+":
+            new -= 1
+        out.append(line)
+        continue
+    m = HUNK.match(line)
+    if m:
+        old = int(m.group(1) or 1)
+        new = int(m.group(2) or 1)
+    elif line.startswith(b"+++ ") and not (out and out[-1].startswith(b"--- ")):
+        out.append(b"--- " + line[4:])
+    out.append(line)
+with open(dst, "wb") as f:
+    f.write(b"\n".join(out))
diff --git a/lorie/src/main/cpp/recipes/run-makekeys.cmake b/lorie/src/main/cpp/recipes/run-makekeys.cmake
new file mode 100644
index 0000000..73865e5
--- /dev/null
+++ b/lorie/src/main/cpp/recipes/run-makekeys.cmake
@@ -0,0 +1,10 @@
+# Runs makekeys on the keysym headers in the current directory and writes its stdout to ${OUT}.
+# Used on Windows hosts, where the custom command cannot rely on a POSIX shell for "> file".
+execute_process(
+        COMMAND "${MAKEKEYS}" "keysymdef.h" "XF86keysym.h" "Sunkeysym.h" "DECkeysym.h" "HPkeysym.h"
+        OUTPUT_FILE "${OUT}"
+        RESULT_VARIABLE rc)
+if(NOT rc EQUAL 0)
+    file(REMOVE "${OUT}")
+    message(FATAL_ERROR "makekeys failed (${rc})")
+endif()
