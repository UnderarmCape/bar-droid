+/* BAR Droid: no window manager runs, so a full-screen window would keep its old size when the screen changes size
+ * (a foldable folding or unfolding). Mapped top-level windows at the origin follow the screen, like maximized
+ * windows; the server resizes them right away, so this works even while the client is busy (a game loading). */
+static void lorieFitTopLevelWindows(ScreenPtr pScreen) {
+    WindowPtr pWin;
+    for (pWin = pScreen->root->firstChild; pWin; pWin = pWin->nextSib) {
+        XID vlist[4] = { 0, 0, pScreen->width, pScreen->height };
+        if (!pWin->mapped || pWin->overrideRedirect || pWin->drawable.class != InputOutput)
+            continue;
+        if (pWin->origin.x - wBorderWidth(pWin) != 0 || pWin->origin.y - wBorderWidth(pWin) != 0)
+            continue;
+        if (pWin->drawable.width == pScreen->width && pWin->drawable.height == pScreen->height)
+            continue;
+        ConfigureWindow(pWin, CWX | CWY | CWWidth | CWHeight, vlist, serverClient);
+    }
+}
+
+static Bool lorieRefitWorkProc(unused ClientPtr client, unused void *closure) {
+    if (pScreenPtr)
+        lorieFitTopLevelWindows(pScreenPtr);
+    return TRUE;
+}
+
+/* ...and they stay that size, as under a window manager keeping them maximized: SDL clamps its own resize requests to
+ * the screen size it saw at startup (the folded or the unfolded one), so a client resizing such a window is undone
+ * right after its request. Our own resizes have the screen size and pass. */
+static ConfigNotifyProcPtr lorieSavedConfigNotify;
+static int lorieConfigNotify(WindowPtr pWin, int x, int y, int w, int h, int bw, WindowPtr pSib) {
+    ScreenPtr pScreen = pWin->drawable.pScreen;
+    int ret = lorieSavedConfigNotify ? lorieSavedConfigNotify(pWin, x, y, w, h, bw, pSib) : Success;
+    if (ret == Success && pWin->parent == pScreen->root && pWin->mapped && !pWin->overrideRedirect
+            && pWin->drawable.class == InputOutput && x == 0 && y == 0
+            && (w != pScreen->width || h != pScreen->height))
+        QueueWorkProc(lorieRefitWorkProc, NULL, NULL);
+    return ret;
+}
