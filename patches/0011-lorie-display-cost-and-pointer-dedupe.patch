+// BAR Droid: what the display pass costs (docs/CONTAINER-COST.md): the GPU's time per draw (EXT_disjoint_timer_query),
+// the renderer's own time per draw, and how many draws had a new picture against those only for the pointer; logged
+// every 5 s (logcat gles-renderer, "[display-cost]").
+static struct {
+    int state;   // 0: not set up, 1: timer queries, -1: none on this GPU
+    PFNGLGENQUERIESEXTPROC gen;
+    PFNGLBEGINQUERYEXTPROC begin;
+    PFNGLENDQUERYEXTPROC end;
+    PFNGLGETQUERYOBJECTUIVEXTPROC getui;
+    PFNGLGETQUERYOBJECTUI64VEXTPROC getui64;
+    GLuint q[8];
+    bool busy[8];
+    int next;
+    uint64_t gpuNs, gpuTimed, cpuNs, draws, pictures, pointerOnly, skipped, lastLog;
+    bool pointerShown;   // the last draw drew the pointer
+} bdCost;
+
+static uint64_t bdNowNs() { struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts); return (uint64_t) ts.tv_sec * 1000000000ull + ts.tv_nsec; }
+
+static void bdCostCollect() {
+    for (int i = 0; i < 8; i++) {
+        if (!bdCost.busy[i])
+            continue;
+        GLuint avail = 0;
+        bdCost.getui(bdCost.q[i], GL_QUERY_RESULT_AVAILABLE_EXT, &avail);
+        if (!avail)
+            continue;
+        GLuint64 ns = 0;
+        bdCost.getui64(bdCost.q[i], GL_QUERY_RESULT_EXT, &ns);
+        bdCost.busy[i] = false;
+        GLint disjoint = 0;
+        glGetIntegerv(GL_GPU_DISJOINT_EXT, &disjoint);
+        if (!disjoint && ns < 1000000000ull) {
+            bdCost.gpuNs += ns;
+            bdCost.gpuTimed++;
+        }
+    }
+}
+
+static int bdCostBegin() {
+    if (!bdCost.state) {
+        const char* ext = (const char*) glGetString(GL_EXTENSIONS);
+        bdCost.gen = (PFNGLGENQUERIESEXTPROC) eglGetProcAddress("glGenQueriesEXT");
+        bdCost.begin = (PFNGLBEGINQUERYEXTPROC) eglGetProcAddress("glBeginQueryEXT");
+        bdCost.end = (PFNGLENDQUERYEXTPROC) eglGetProcAddress("glEndQueryEXT");
+        bdCost.getui = (PFNGLGETQUERYOBJECTUIVEXTPROC) eglGetProcAddress("glGetQueryObjectuivEXT");
+        bdCost.getui64 = (PFNGLGETQUERYOBJECTUI64VEXTPROC) eglGetProcAddress("glGetQueryObjectui64vEXT");
+        bdCost.state = ext && strstr(ext, "GL_EXT_disjoint_timer_query") && bdCost.gen && bdCost.begin && bdCost.end
+                       && bdCost.getui && bdCost.getui64 ? 1 : -1;
+        if (bdCost.state > 0)
+            bdCost.gen(8, bdCost.q);
+        log("[display-cost] GPU timer queries %s", bdCost.state > 0 ? "on" : "unavailable");
+    }
+    if (bdCost.state < 0)
+        return -1;
+    bdCostCollect();
+    for (int k = 0; k < 8; k++) {
+        int i = (bdCost.next + k) % 8;
+        if (!bdCost.busy[i]) {
+            bdCost.next = (i + 1) % 8;
+            bdCost.begin(GL_TIME_ELAPSED_EXT, bdCost.q[i]);
+            return i;
+        }
+    }
+    return -1;
+}
+
+static void bdCostEnd(int i) {
+    if (i < 0)
+        return;
+    bdCost.end(GL_TIME_ELAPSED_EXT);
+    bdCost.busy[i] = true;
+}
+
+static void bdCostLog() {
+    uint64_t now = bdNowNs();
+    if (!bdCost.lastLog)
+        bdCost.lastLog = now;
+    if (now - bdCost.lastLog < 5000000000ull)
+        return;
+    double s = (double) (now - bdCost.lastLog) * 1e-9;
+    log("[display-cost] %llu draws in %.1f s (%llu new pictures, %llu for the pointer only, %llu pointer-only skipped); "
+        "GPU %.2f ms a draw (%llu timed), %.1f ms of GPU a second; renderer %.2f ms a draw",
+        (unsigned long long) bdCost.draws, s, (unsigned long long) bdCost.pictures, (unsigned long long) bdCost.pointerOnly,
+        (unsigned long long) bdCost.skipped,
+        bdCost.gpuTimed ? (double) bdCost.gpuNs / (double) bdCost.gpuTimed * 1e-6 : 0.0, (unsigned long long) bdCost.gpuTimed,
+        bdCost.gpuTimed && bdCost.draws ? (double) bdCost.gpuNs / (double) bdCost.gpuTimed * (double) bdCost.draws / s * 1e-6 : 0.0,
+        bdCost.draws ? (double) bdCost.cpuNs / (double) bdCost.draws * 1e-6 : 0.0);
+    bdCost.gpuNs = bdCost.gpuTimed = bdCost.cpuNs = bdCost.draws = bdCost.pictures = bdCost.pointerOnly = bdCost.skipped = 0;
+    bdCost.lastLog = now;
+}
