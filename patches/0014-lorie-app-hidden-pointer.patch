             {"setCursorVisible", "(JZ)V", (void *) +[](__unused JNIEnv *env, __unused jobject thiz, jlong ptr, jboolean visible) {
                 auto* r = (LorieViewResources*) ptr;
                 if (!r || r->destroyed || !r->renderer.state) return;
