--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -27,6 +27,12 @@
 # add it explicitly. macOS/Mach-O needs the xcode variant (underscore-mangled
 # symbols) regardless of compiler; the generic glob handles the .cpp half.
 if (APPLE AND CMAKE_SYSTEM_PROCESSOR MATCHES "arm64|aarch64")
 	enable_language(ASM)
 	set(additionalSources  ${additionalSources} ${CMAKE_CURRENT_SOURCE_DIR}/src/lib/angelscript/source/as_callfunc_arm64_xcode.S)
+elseif (NOT WIN32 AND CMAKE_SYSTEM_PROCESSOR MATCHES "arm64|aarch64")
+	# Linux (and other ELF) arm64: the gcc/clang variant of the same stub. Without it
+	# libSkirmishAI.so is built with undefined CallARM64* symbols and the engine dies
+	# with "symbol lookup error: ... undefined symbol: CallARM64RetInMemory" on AI init.
+	enable_language(ASM)
+	set(additionalSources  ${additionalSources} ${CMAKE_CURRENT_SOURCE_DIR}/src/lib/angelscript/source/as_callfunc_arm64_gcc.S)
 endif ()
