+// BAR Droid: the display's vsync for the engine's frame cap (libbardroid_pace.so maps the same file):
+// [0] the last vsync (CLOCK_MONOTONIC ns), [1] the time between two vsyncs (ns), [2] and [10] from the engine (lorieMinHold),
+// [3..9] how many pictures stayed on screen for 1..7 vsyncs (7: or more). BARDROID_VSYNC_FILE: the file.
+static void lorieShareVsync(int64_t t) {
+    static int tried, mismatches;
+    static int64_t last;
+    if (!tried) {
+        const char *path = getenv("BARDROID_VSYNC_FILE");
+        int fd = path ? open(path, O_RDWR | O_CREAT | O_CLOEXEC, 0600) : -1;
+        tried = 1;
+        if (fd >= 0) {
+            if (ftruncate(fd, 4096) == 0) {
+                void *m = mmap(NULL, 4096, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+                if (m != MAP_FAILED)
+                    vsyncShared = m;
+            }
+            close(fd);
+        }
+    }
+    if (!vsyncShared)
+        return;
+    int64_t d = t - last, period = vsyncShared[1];
+    last = t;
+    if (d > 2000000 && d < 120000000) {   // (a skipped vsync or a stop says nothing about the period)
+        if (!period || mismatches >= 8)
+            vsyncShared[1] = d, mismatches = 0;   // the first one, or the display changed its rate
+        else if (d > period - period / 5 && d < period + period / 5)
+            vsyncShared[1] = period + (d - period) / 16, mismatches = 0;
+        else
+            mismatches++;
+    }
+    vsyncShared[0] = t;
+}
