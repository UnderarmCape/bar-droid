+
+// BAR Droid: the root window through SGSR 1 (the texture bound, the viewport set). Builds the program on first use;
+// false (plain filtering) when there is no shader or this GPU refuses it.
+bool Renderer::drawRootUpscaled(const LorieBuffer_Desc* desc, float u0, float v0, float u1, float v1, uint8_t flip) {
+    if (sgsrState < 0 || !sgsrSource)
+        return false;
+    if (!sgsrState) {
+        log("Xlorie: SGSR 1 upscaling on %s", (const char*) glGetString(GL_VERSION));
+        sgsrProgram = createProgram(sgsrVertexShaderSrc, sgsrSource);
+        if (!sgsrProgram) {
+            log("Xlorie: SGSR 1 unavailable on this GPU: plain filtering");
+            sgsrState = -1;
+            return false;
+        }
+        sgsrPos = (GLuint) glGetAttribLocation(sgsrProgram, "position");
+        sgsrCoords = (GLuint) glGetAttribLocation(sgsrProgram, "texCoords");
+        sgsrViewportInfo = glGetUniformLocation(sgsrProgram, "ViewportInfo");
+        sgsrTexture = glGetUniformLocation(sgsrProgram, "ps0");
+        sgsrState = 1;
+    }
+
+    float coords[16] = {
+        -1.f, 1.f, u0, v0,
+        1.f, 1.f, u1, v0,
+        -1.f, -1.f, u0, v1,
+        1.f, -1.f, u1, v1,
+    };
+    // the texture's own size: a CPU-uploaded buffer is as wide as its stride
+    float texW = (float) (desc->type == LORIEBUFFER_FD ? desc->stride : desc->width), texH = (float) desc->height;
+
+    glActiveTexture(GL_TEXTURE0);
+    glUseProgram(sgsrProgram);
+    glUniform4f(sgsrViewportInfo, 1.f / texW, 1.f / texH, texW, texH);
+    glUniform1i(sgsrTexture, 0);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    if (flip) {   // the plain program's .bgra, as the texture's swizzle (SGSR's green luma taps stay green)
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_R, GL_BLUE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_B, GL_RED);
+    }
+    glVertexAttribPointer(sgsrPos, 2, GL_FLOAT, GL_FALSE, 16, coords);
+    glVertexAttribPointer(sgsrCoords, 2, GL_FLOAT, GL_FALSE, 16, &coords[2]);
+    glEnableVertexAttribArray(sgsrPos);
+    glEnableVertexAttribArray(sgsrCoords);
+    glDrawArrays(GL_TRIANGLE_STRIP, 0, 4); checkGlError();
+    glDisableVertexAttribArray(sgsrPos);
+    glDisableVertexAttribArray(sgsrCoords);
+    if (flip) {
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_R, GL_RED);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_B, GL_BLUE);
+    }
+    return true;
+}
